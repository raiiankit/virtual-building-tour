# Copy to .env and adjust. All values have safe local defaults.

# development | production. In production the app refuses to boot on the default SECRET_KEY.
ENV=development

# REQUIRED in production — a long random string (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_HOURS=72

# CORS allowed origins (comma-separated). Empty/unset = wide-open in dev only.
# CORS_ORIGINS=https://app.example.com

# Default is local SQLite (no setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/vbt

# Local disk storage by default:
# STORAGE_DIR=/absolute/path/to/storage
MAX_UPLOAD_MB=25

# Frontend → backend proxy target (used by fronted/next.config.mjs rewrites)
# BACKEND_URL=http://localhost:8000
