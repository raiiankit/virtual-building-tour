# ---------------------------------------------------------------------------
# AI Virtual Building Tour — .gitignore
# ---------------------------------------------------------------------------

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Secrets / environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python (backend) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js (fronted) ---
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.npm/
.pnp.*
.yarn/*
!.yarn/patches

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- App data / generated artifacts (regenerable, not source) ---
# SQLite dev database
app.db
*.sqlite
*.sqlite3
# uploaded plans + generated GLB / scene manifests / rendered videos
storage/
# stale legacy frontend build cache left after the web/ -> fronted/ rename
web/

# --- Misc ---
.cache/
tmp/
coverage/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
